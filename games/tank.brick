# tank.brick
GAME_TYPE TANK

GAME_GRID (30,30)

DEFINE SHAPE PLAYER_TANK:
  STATE 1:
    [1,1]
	[1,1]
END


ON START:
  SPAWN PLAYER AT (15, 15)
END

# --- Controles ---
ON KEY_ENTER:
  SPAWN BULLET
END

ON KEY_UP:
  MOVE PLAYER UP
END
ON KEY_DOWN:
  MOVE PLAYER DOWN
END
ON KEY_LEFT:
  MOVE PLAYER LEFT
END
ON KEY_RIGHT:
  MOVE PLAYER RIGHT
END
