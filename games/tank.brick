# tank.brick
GAME_TYPE TANK

GAME_GRID (30,30)
TARGET_SCORE 700
WALL_COLLISION OFF

DEFINE SHAPE PLAYER_TANK:
  HP: 100
  DMG: 100
  TYPE: PLAYER
  STATE 1:
    [1]
END

DEFINE SHAPE BULLET:
  STYLE: CIRCLE
  COLOR: 110000
  TYPE: ITEM
  DMG: 100
  STATE 1:
    [1]
END

DEFINE SHAPE TANK_RESISTANT:
  STYLE: TRIANGLE
  COLOR: 000099
  TYPE: ENEMY
  HP: 300
  DMG: 50
  VELOCITY: 10
  STATE 1:
    [1]
END

DEFINE SHAPE TANK_FAST:
  STYLE: TRIANGLE
  COLOR: 009900
  TYPE: ENEMY
  HP: 50
  DMG: 10
  VELOCITY: 3
  STATE 1:
    [1]
END

DEFINE SHAPE TANK:
  STYLE: TRIANGLE
  COLOR: 998400
  TYPE: ENEMY
  HP: 100
  DMG: 20
  VELOCITY: 5
  STATE 1:
    [1]
END

DEFINE SHAPE BOSS:
  TYPE: BOSS
  STYLE: TRIANGLE
  COLOR: 000000
  HP: 2000
  DMG: 50
  VELOCITY: 5
  STATE 1:
    [1,1]
	[1,1]
END

ON TICK:
  MOVE ITEM FORWARD
  CHECK_OBJ_COLLISION ITEM
  MOVE ENEMY FORWARD
  MOVE BOSS FORWARD
  CHECK_OBJ_COLLISION ENEMY
  CHECK_OBJ_COLLISION PLAYER
END

ON TARGET_SCORE:
  LEVELS FINAL
  SPAWN BOSS AT (15,15)
  TRASLADE PLAYER AT (15, 1)
END

# SLOWER TICK
ON STICK:
  SPAWN ITEM AT ENEMY
  SPAWN ITEM AT BOSS
END

ON START:
  SPAWN PLAYER AT (15, 15)
END

ON RANDOM:
  SPAWN ENEMY AT RANDOM
  SPAWN COMIDA AT RANDOM
END

ON ENEMY_DIED:
  INCREASE_SCORE 50
  REMOVE ENEMY
END

ON COLLISION:
  GAME_OVER
END

ON WIN:
  GAME_WIN
END
  
# --- Controles ---
ON KEY_RETURN:
  SPAWN ITEM AT PLAYER
END

ON KEY_UP:
  MOVE PLAYER UP
END
ON KEY_DOWN:
  MOVE PLAYER DOWN
END
ON KEY_LEFT:
  MOVE PLAYER LEFT
END
ON KEY_RIGHT:
  MOVE PLAYER RIGHT
END
