# tank.brick
GAME_TYPE TANK

GAME_GRID (30,30)

DEFINE SHAPE PLAYER_TANK:
  TYPE: PLAYER
  STATE 1:
    [1]
END

DEFINE SHAPE BULLET:
  STATE 1:
    [1]
END

DEFINE SHAPE TANK:
  TYPE: ENEMY
  HP: 100
  STATE 1:
    [1]
END

ON START:
  SPAWN PLAYER AT (15, 15)
END

ON RANDOM:
  SPAWN ENEMY AT RANDOM
END

ON ENEMY_DEAD:
  INCREASE_SCORE 50
END

ON COLLISION:
  GAME_OVER
END

# --- Controles ---
ON KEY_ENTER:
  SPAWN BULLET
  MOVE BULLET FORWARD
END

ON KEY_UP:
  MOVE PLAYER UP
END
ON KEY_DOWN:
  MOVE PLAYER DOWN
END
ON KEY_LEFT:
  MOVE PLAYER LEFT
END
ON KEY_RIGHT:
  MOVE PLAYER RIGHT
END
