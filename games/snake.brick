# snake.brick
GAME_TYPE SNAKE

GAME_GRID (18, 18)
LEVELS ENTUSIASTA
POWER ON
POWER_TIME 2

# --- Definicion de Elementos ---
DEFINE SHAPE PIXEL:
  STYLE: CIRCLE
  STATE 1:
    [1]
END

# --- Logica y Reglas ---
ON START:
  SPAWN PLAYER AT (9, 9)
  SPAWN FOOD AT RANDOM
END

# ON_TICK es un evento que se ejecuta en cada ciclo del juego
ON TICK:
  MOVE PLAYER FORWARD
END

ON EAT_BFOOD:
  DECREASE_SCORE 10
  DECREASE 1
END

ON EAT_YFOOD:
  INCREASE_SCORE 50
  GROW 2
END

ON DIFD:
  SPAWN BFOOD AT RANDOM
END

ON POWERUP:
  SPAWN YFOOD AT RANDOM
END

# Evento para cuando la serpiente come
ON EAT_FOOD:
  INCREASE_SCORE 10
  GROW 1
  SPAWN FOOD AT RANDOM
END

# Eventos de fin de juego
ON COLLISION_WALL_NYAN:
  SET_SCORE 0
  DECREASE ALL
END

ON COLLISION_WALL:
  GAME_OVER
END
ON COLLISION_SELF:
  GAME_OVER
END

# --- Controles ---
ON KEY_UP:
  SET_DIRECTION UP
END
ON KEY_DOWN:
  SET_DIRECTION DOWN
END
ON KEY_LEFT:
  SET_DIRECTION LEFT
END
ON KEY_RIGHT:
  SET_DIRECTION RIGHT
END
