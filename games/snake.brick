GAME_TYPE SNAKE

GAME_GRID (18, 18)

# --- Definicion de Elementos ---
DEFINE SHAPE PIXEL:
  STATE 1:
    [1]
END

# --- Inicio del Juego ---
ON START:
  SPAWN PLAYER AT (9, 9)

  # Comida normal
  SPAWN FOOD AT RANDOM

  # Bonus especial x2
  SPAWN BONUS AT RANDOM
END

# --- Movimiento automatico ---
ON TICK:
  MOVE PLAYER FORWARD
END

# --- Comida normal ---
ON EAT_FOOD:
  INCREASE_SCORE 10
  GROW PLAYER 1
  SPAWN FOOD AT RANDOM
END

# --- Bonus especial ---
# Da muchos mas puntos para simular evento x2
ON EAT_BONUS:
  INCREASE_SCORE 50
  GROW PLAYER 2

  # Vuelve a aparecer el bonus
  SPAWN BONUS AT RANDOM
END

# --- Eventos de fin del juego ---
ON COLLISION_WALL:
  GAME_OVER
END

ON COLLISION_SELF:
  GAME_OVER
END

# --- Controles ---
ON KEY_UP:
  SET_DIRECTION UP
END

ON KEY_DOWN:
  S
